# העתיקי את הקובץ הזה ל-.env ומלאי רק את מה שצריך. הקובץ .env לא עולה לגיט.
# כל השורות לא חובה: בלי מפתחות האתר עובד, והחלקים החסרים אומרים זאת בגלוי.

# ---------- כללי ----------
# כתובת האתר, לקישורים במיילים ול-Google
TIMEFLOW_BASE_URL=http://127.0.0.1:5000
# מפתח הצפנה לעוגיות. בלי זה נוצר מפתח אקראי ב-instance/secret_key
# TIMEFLOW_SECRET_KEY=
# 1 רק כשהאתר רץ ב-HTTPS (עוגיות מאובטחות)
# TIMEFLOW_HTTPS=1
# 0 כדי לכבות את מצב debug
# TIMEFLOW_DEBUG=1

# ---------- AI ב-Snooze (Claude) ----------
# המפתח נשאר בשרת בלבד ולא נשלח לדפדפן. https://console.anthropic.com
# ANTHROPIC_API_KEY=
# TIMEFLOW_AI_MODEL=claude-opus-5-5
# כמה בקשות AI ביום לכל משתמשת
# TIMEFLOW_AI_DAILY_LIMIT=20

# ---------- מייל ----------
# בלי SMTP המיילים נשמרים כקבצים ב-instance/outbox (מצב פיתוח)
# ב-Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, וסיסמת אפליקציה (App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SSL=1
# SMTP_USER=your.name@gmail.com
# SMTP_PASSWORD=
# MAIL_FROM=your.name@gmail.com
# thread = שליחה מתוך השרת, off = כשמריצים את flask send-daily מ-Task Scheduler
# TIMEFLOW_SCHEDULER=thread

# ---------- Google Calendar (קריאה בלבד) ----------
# יוצרים OAuth Client מסוג Web application ב-Google Cloud Console
# ומוסיפים Redirect URI: http://127.0.0.1:5000/zehava/calendar/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
